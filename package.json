{
  "name": "riplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:dev:api": "wrangler dev --config wrangler.api.jsonc",
    "cf:deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "cf:preview:web": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:web": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "jose": "^6.1.0",
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@opennextjs/cloudflare": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.8.0",
    "wrangler": "latest"
  }
}
