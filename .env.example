# Add secrets through your deployment platform's encrypted secret store.
# Never commit real credentials.

# Public browser-side API base URL for the deployed Aiplay API Worker
NEXT_PUBLIC_AIPLAY_API_URL=

# NVIDIA credentials are Worker secrets, not browser variables.
# Configure with: npx wrangler secret put NVIDIA_API_KEY --config wrangler.api.jsonc
# Optional Worker variable if NVIDIA supplies an account-specific invocation URL:
# NVIDIA_API_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Worker-side key used only to call Supabase Auth user verification endpoint
SUPABASE_ANON_KEY=

# Cloudflare (deployment credentials belong in CI/deployment secrets)
CLOUDFLARE_ACCOUNT_ID=
